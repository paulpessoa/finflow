<div id="modal-overlay" class="modal-overlay" onclick="document.getElementById('modal-overlay').remove()">
    <div class="modal-content glass" onclick="event.stopPropagation()">
        <header class="modal-header">
            <h3><%= transaction ? 'Editar Transação' : 'Nova Transação' %></h3>
            <button class="btn-close" onclick="document.getElementById('modal-overlay').remove()">&times;</button>
        </header>

        <div id="form-feedback"></div>

        <form 
            id="transaction-form"
            class="fin-form"
            hx-post="<%= transaction ? '/transactions/' + transaction.id : '/transactions' %>"
            hx-target="#form-feedback"
            hx-swap="innerHTML"
        >
            <div class="form-group">
                <label>Descrição</label>
                <input type="text" name="description" value="<%= transaction ? transaction.description : '' %>" required placeholder="Ex: Mercado, Aluguel...">
            </div>

            <div class="form-group">
                <label>Valor (R$)</label>
                <input type="number" step="0.01" name="amount" value="<%= transaction ? transaction.amount : '' %>" required placeholder="0.00">
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Tipo</label>
                    <select name="type">
                        <option value="EXPENSE" <%= (transaction && transaction.type === 'EXPENSE') ? 'selected' : '' %>>Saída 💸</option>
                        <option value="INCOME" <%= (transaction && transaction.type === 'INCOME') ? 'selected' : '' %>>Entrada 💰</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Data</label>
                    <input type="date" name="date" value="<%= transaction ? new Date(transaction.date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>" required>
                </div>
            </div>

            <div class="form-group">
                <label>Categoria</label>
                <select name="categoryId" id="category-select" hx-get="/api-proxy/categories" hx-trigger="load" hx-target="this">
                    <option value="">Carregando categorias...</option>
                </select>
                <% if (transaction) { %>
                <script>
                    document.body.addEventListener('htmx:afterOnLoad', function(evt) {
                        if (evt.detail.target.id === 'category-select') {
                            setTimeout(() => {
                                document.getElementById('category-select').value = '<%= transaction.categoryId %>';
                            }, 50);
                        }
                    });
                </script>
                <% } %>
            </div>

            <div class="form-group">
                <label>Notas</label>
                <!-- O campo no banco é 'notes' -->
                <textarea name="notes" placeholder="Algum detalhe adicional..."><%= transaction ? transaction.notes : '' %></textarea>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('modal-overlay').remove()">Cancelar</button>
                <button type="submit" class="btn btn-primary">
                    <%= transaction ? 'Salvar Alterações' : 'Criar Transação' %>
                </button>
            </div>
        </form>
    </div>
</div>
