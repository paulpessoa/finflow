<% if (!insights) { %>
    <!-- CONTAINER RAIZ: Estado de Prompt -->
    <div class="ai-container glass" id="ai-insights-box">
        <div class="ai-prompt-layout">
            <div class="ai-text-group">
                <span class="ai-badge-chip">IA</span>
                <p class="ai-desc-text">Descubra padrões nos seus gastos e receba dicas de economia com nossa Inteligência Artificial.</p>
            </div>
            <button 
                class="btn-ai-launch" 
                hx-post="/api-proxy/ai/insights" 
                hx-indicator="#ai-insights-box"
                hx-target="#ai-insights-box"
                hx-swap="outerHTML"
            >
                ✨ Gerar Análise
            </button>
        </div>

        <div class="ai-loading-screen">
            <div class="ai-spinner"></div>
            <span>Analisando suas finanças...</span>
        </div>
    </div>
<% } else { %>
    <!-- CONTAINER RAIZ: Estado de Resultado (Substitui o anterior via outerHTML) -->
    <div class="ai-container glass result-view">
        <div class="ai-header-row">
            <div class="ai-header-main">
                <span class="ai-header-icon">✨</span>
                <div>
                    <h4>Análise Inteligente</h4>
                    <span class="ai-header-sub">Status: <strong class="status-text-<%= insights.rating.toLowerCase() %>"><%= insights.rating %></strong></span>
                </div>
            </div>
            <button class="btn-refresh-ai" onclick="window.location.reload()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.85.83 6.72 2.24"></path><path d="M21 3v9h-9"></path></svg>
                Atualizar Análise
            </button>
        </div>

        <div class="ai-body-grid">
            <div class="ai-col">
                <h6 class="ai-col-label">Principais Insights</h6>
                <ul class="ai-points">
                    <% insights.insights.forEach(item => { %>
                        <li><%= item %></li>
                    <% }) %>
                </ul>
            </div>

            <div class="ai-col">
                <h6 class="ai-col-label">Plano de Ação</h6>
                <div class="ai-step-group">
                    <% insights.actionPlan.forEach((step, index) => { %>
                        <div class="ai-step-card">
                            <span class="ai-step-number"><%= index + 1 %></span>
                            <p><%= step %></p>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
<% } %>

<style>
    /* Root Container */
    .ai-container {
        margin: 1.5rem 0;
        padding: 1.5rem;
        border-radius: 1.25rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(30, 41, 59, 0.4);
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    /* Prompt Layout */
    .ai-prompt-layout {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
    }
    .ai-text-group { display: flex; align-items: center; gap: 1rem; }
    .ai-badge-chip {
        background: linear-gradient(135deg, #6366f1, #a855f7);
        color: white;
        padding: 0.25rem 0.65rem;
        border-radius: 0.5rem;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.05em;
    }
    .ai-desc-text { color: #94a3b8; margin: 0; font-size: 0.95rem; font-weight: 500; }
    
    .btn-ai-launch {
        background: #6366f1;
        color: white;
        border: none;
        padding: 0.75rem 1.75rem;
        border-radius: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }
    .btn-ai-launch:hover { background: #4f46e5; transform: translateY(-2px); box-shadow: 0 6px 16px rgba(99, 102, 241, 0.4); }
    .btn-ai-launch:active { transform: translateY(0); }

    /* Result View Styles */
    .ai-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .ai-header-main { display: flex; align-items: center; gap: 1rem; }
    .ai-header-icon { font-size: 1.5rem; filter: drop-shadow(0 0 8px rgba(99, 102, 241, 0.5)); }
    .ai-header-main h4 { margin: 0; font-size: 1.25rem; font-weight: 700; color: #f8fafc; }
    .ai-header-sub { font-size: 0.8rem; color: #64748b; font-weight: 500; }

    .status-text-saudável { color: #10b981; }
    .status-text-alerta { color: #f59e0b; }
    .status-text-crítico { color: #ef4444; }

    .btn-refresh-ai {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        color: #94a3b8;
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.5rem 1rem;
        border-radius: 0.75rem;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-refresh-ai:hover { background: rgba(255, 255, 255, 0.1); color: #f8fafc; border-color: rgba(255, 255, 255, 0.2); }

    .ai-body-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2rem; }
    @media (max-width: 768px) { .ai-body-grid { grid-template-columns: 1fr; } }

    .ai-col-label { color: #64748b; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.1em; font-weight: 800; margin-bottom: 1.25rem; display: block; }
    .ai-points { list-style: none; padding: 0; margin: 0; }
    .ai-points li { position: relative; padding-left: 1.5rem; margin-bottom: 0.75rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.5; }
    .ai-points li::before { content: "✦"; position: absolute; left: 0; color: #6366f1; font-size: 0.8rem; top: 0.1rem; }

    .ai-step-group { display: flex; flex-direction: column; gap: 0.75rem; }
    .ai-step-card { background: rgba(255, 255, 255, 0.03); padding: 1rem; border-radius: 1rem; border: 1px solid rgba(255, 255, 255, 0.03); display: flex; gap: 1rem; align-items: flex-start; transition: background 0.2s; }
    .ai-step-card:hover { background: rgba(255, 255, 255, 0.05); }
    .ai-step-number { background: #6366f1; min-width: 20px; height: 20px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; color: white; margin-top: 2px; }
    .ai-step-card p { margin: 0; font-size: 0.9rem; color: #94a3b8; line-height: 1.5; }

    /* Loading UI */
    .ai-loading-screen {
        position: absolute; inset: 0; display: none; flex-direction: column; align-items: center; justify-content: center;
        gap: 1.25rem; background: rgba(15, 23, 42, 0.8); color: #818cf8; font-weight: 600; backdrop-filter: blur(8px);
    }
    .htmx-request#ai-insights-box .ai-loading-screen { display: flex; }
    .htmx-request#ai-insights-box .ai-prompt-layout { visibility: hidden; } /* Hide prompt but keep height */
    
    .ai-spinner { width: 28px; height: 28px; border: 3px solid rgba(99, 102, 241, 0.1); border-top-color: #6366f1; border-radius: 50%; animation: ai-spin 0.8s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
    @keyframes ai-spin { to { transform: rotate(360deg); } }
</style>