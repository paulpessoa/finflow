<div class="ai-smart-query glass">
    <div class="query-top-row">
        <div class="ai-title-group">
            <span class="ai-icon-sparkle">✨</span>
            <div class="ai-title-text">
                <h5>Assistente Inteligente</h5>
                <p>Tire dúvidas sobre suas finanças em tempo real</p>
            </div>
        </div>
        <div class="ai-suggestions">
            <button class="chip-suggestion" onclick="fillQuery('Qual foi meu maior gasto este mês?')">Maiores gastos</button>
            <button class="chip-suggestion" onclick="fillQuery('Como posso economizar mais?')">Dicas de economia</button>
            <button class="chip-suggestion" onclick="fillQuery('Resuma meu perfil de consumo')">Perfil de consumo</button>
        </div>
    </div>

    <div class="query-input-wrapper">
        <form id="ai-chat-form" onsubmit="handleChatSubmit(event)" class="query-form">
            <div class="input-glow-container">
                <input 
                    type="text" 
                    id="chat-input" 
                    placeholder="Pergunte algo... ex: 'Analise meus gastos com alimentação'" 
                    required 
                    autocomplete="off"
                >
                <button type="submit" class="btn-query-send" title="Consultar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
            </div>
        </form>
    </div>
    
    <div id="query-result-container" class="query-result-container" style="display: none;">
        <div class="result-header">
            <div class="badge-ai-row">
                <span class="badge-ai">Resposta da IA</span>
                <div class="pulse-indicator"></div>
            </div>
            <button class="btn-close-res" onclick="closeResult()" title="Fechar">×</button>
        </div>
        <div id="chat-history" class="query-response">
            <!-- As respostas aparecerão aqui -->
        </div>
    </div>
</div>

<script>
    function fillQuery(text) {
        const input = document.getElementById('chat-input');
        input.value = text;
        input.focus();
    }

    function closeResult() {
        document.getElementById('query-result-container').style.display = 'none';
        document.getElementById('chat-history').innerHTML = '';
    }

    async function handleChatSubmit(event) {
        event.preventDefault();
        const input = document.getElementById('chat-input');
        const container = document.getElementById('query-result-container');
        const history = document.getElementById('chat-history');
        const question = input.value;

        if (!question) return;

        // Limpar e mostrar container
        container.style.display = 'block';
        history.innerHTML = '<div class="typing-indicator"><span>.</span><span>.</span><span>.</span></div>';
        
        // Scroll para o resultado
        container.scrollIntoView({ behavior: 'smooth', block: 'center' });

        try {
            const response = await fetch('/api-proxy/ai/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `question=${encodeURIComponent(question)}`
            });

            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            
            // Limpar indicador de digitação
            history.innerHTML = '<div class="ai-response-bubble"><p class="ai-text"></p></div>';
            const textElement = history.querySelector('.ai-text');

            while (true) {
                const { value, done } = await reader.read();
                if (done) break;
                
                const chunk = decoder.decode(value, { stream: true });
                textElement.innerText += chunk;
            }
        } catch (error) {
            history.innerHTML = '<p class="error">Erro ao consultar a IA. Tente novamente.</p>';
        }
    }
</script>

